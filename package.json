{
  "name": "savia-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Savia backend health service.",
  "engines": {
    "node": "24.18.0",
    "pnpm": "11.13.0"
  },
  "packageManager": "pnpm@11.13.0",
  "scripts": {
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "architecture:check": "depcruise --config .dependency-cruiser.cjs --output-type err src && node scripts/verify-migration-tests.mjs && node scripts/verify-financial-tables.mjs && node scripts/verify-financial-idempotency.mjs && node scripts/verify-test-gates.mjs && node scripts/verify-test-script-reachability.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:database": "supabase test db --local supabase/tests/database/identity_rls.test.sql",
    "test:database:bootstrap": "supabase test db --local supabase/tests/database/identity_bootstrap_rls.test.sql",
    "test:integration:postgres-pool": "bash scripts/run-disposable-database-suite.sh test/identity/postgres-pool.integration-spec.ts",
