  "dependencies": {
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-fastify": "11.1.28",
    "fastify": "5.10.0",
    "jose": "6.2.3",
    "pg": "8.22.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@nestjs/testing": "11.1.28",
    "@redocly/cli": "2.39.0",
    "@types/node": "24.10.1",
    "@types/pg": "8.20.0",
