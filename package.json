    "ajv-formats": "^3.0.1",
    "dependency-cruiser": "^18.2.0",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.6.2",
    "supabase": "2.109.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.52.0",
    "vitest": "4.1.10"
  }
