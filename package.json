    "test:integration:catalogs-create": "bash scripts/run-disposable-database-suite.sh test/catalogs/catalogs-create.integration-spec.ts",
    "test:integration:catalogs-list": "bash scripts/run-disposable-database-suite.sh test/catalogs/catalogs-list.integration-spec.ts",
