    "test:integration:subscriptions-schema": "bash scripts/run-disposable-database-suite.sh test/identity/subscriptions-schema.integration-spec.ts",
    "test:integration:subscriptions-list": "bash scripts/run-disposable-database-suite.sh test/recurring/subscriptions-list.integration-spec.ts",
    "test:integration:jobs-schema": "bash scripts/run-disposable-database-suite.sh test/identity/jobs-schema.integration-spec.ts",
    "test:integration:jobs-read": "bash scripts/run-disposable-database-suite.sh test/jobs/jobs-read.integration-spec.ts",
